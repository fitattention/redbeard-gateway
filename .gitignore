# Public repo: track ONLY the files whitelisted below. Everything else in this folder is excluded so nothing can
# leak -- the real plans.json (true token limits), the key database, the deploy/ scripts (server IP + domain),
# the virtualenv, and the local PowerShell helpers.
/*
!/app.py
!/meter.py
!/store.py
!/admin.py
!/checkout.py
!/stats.py
!/backoffice.py
!/test_gateway.py
!/README.md
!/LICENSE
!/requirements.txt
!/plans.example.json
!/.gitignore
